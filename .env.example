# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=xxx

# Billing — leave unset (Free Mode) unless every gate in OBJECTIVES.md §8 has passed.
# Only "paid" requests Paid Mode, and it takes effect only if all four Razorpay
# variables below pass the server's readiness check (secrets ≥ 16 chars, public
# key id equal to RAZORPAY_KEY_ID, rzp_live_ keys only in production builds).
# Razorpay credentials on their own never turn payments on.
# Do NOT set this to "paid" in production: the §8 gates are not met. Paid Mode
# is for local work with Razorpay test keys only, and needs the tables from
# supabase/migrations/0002_payment_orders.sql and
# 0003_fulfilment_failed_and_webhook_events.sql.
# BILLING_MODE=free

# Razorpay — https://dashboard.razorpay.com (Test Mode). Not needed in Free Mode.
# The placeholder values below fail the readiness check on purpose.
#
# Key id (Settings → API Keys). Must start with rzp_test_ outside production.
# Server only here; the browser gets it from NEXT_PUBLIC_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=rzp_test_xxx
# Key secret, shown once when the key is generated. Signs checkout responses
# (HMAC-SHA256 of "order_id|payment_id"). Server only. Never expose to the browser.
RAZORPAY_KEY_SECRET=xxx
# Secret you choose when adding the webhook (Settings → Webhooks) for
# https://<your-domain>/api/webhooks/razorpay with the events payment.captured
# and payment.failed. Not the key secret. Server only. Never expose to the browser.
RAZORPAY_WEBHOOK_SECRET=xxx
# Public: the key id only, for Checkout in the browser. Must be exactly the
# same value as RAZORPAY_KEY_ID. Never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
